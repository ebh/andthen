{
  "name": "andthen",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "app:export": "tamagui build --target web ./src/ui -- expo export --platform web --output-dir dist-app",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && eslint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "stryker": "stryker run"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/source-serif-4": "0.4.2",
    "@expo/metro-runtime": "58.0.17",
    "@tamagui/config": "3.1.10",
    "@tamagui/core": "3.1.10",
    "@tamagui/web": "3.1.10",
    "expo": "58.0.22",
    "expo-font": "58.0.11",
    "expo-router": "58.0.29",
    "expo-system-ui": "58.0.7",
    "hono": "4.13.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "tamagui": "3.1.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@tamagui/cli": "3.1.10",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "daisyui": "5.7.50",
    "eslint": "10.13.0",
    "eslint-plugin-oxlint": "1.90.0",
    "jsdom": "30.1.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
