{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    // `prepare.ts` runs under Node's type stripping, which needs the extension in imports.
    "allowImportingTsExtensions": true
  },
  "include": ["e2e"]
}
