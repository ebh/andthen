{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.client.tsbuildinfo",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src/client", "src/shared"],
  // live.test.ts belongs to tsconfig.test.json, which types it without the DOM.
  "exclude": ["src/client/live.test.ts"]
}
