{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level is local dev: local D1, local Durable Object, fake AI.
  "name": "andthen-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "andthen-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "STORY_ROOM", "class_name": "StoryRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoryRoom"] }],
  // Always remote. `pnpm dev` runs wrangler with remote bindings off unless `AI_REMOTE=1`, so local runs
  // use the fake provider unless you start dev with `AI_REMOTE=1` after `wrangler login`.
  "ai": { "binding": "AI" },
  // The dev VAPID key's private half is not committed. To receive real pushes locally, put your
  // own pair in `.dev.vars` (see `.dev.vars.example`). Preview and production set the private key
  // as a Worker secret.
  //
  // CLERK_JWT_KEY is the Clerk instance's public key (PEM), so it is safe to commit. Verifying a
  // session token needs it and nothing else. The placeholder rejects every token until the real
  // key replaces it; the dev instance's key serves local and preview, production has its own.
  "vars": {
    "AI_PROVIDER": "fake",
    "CLERK_JWT_KEY": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA0tCAv+NMQD8ZIEQx1DQe\nltHZ2cHdI/9OIobyaZ5nr/+HhNzZQV21azV5C7MXMdWY1SnlkcSjkwT1NfKAg/9F\njAiYOlEWWwZ41vzBiD+hZ2jGR5UhMaf/glec9lG1ZAStqO+FJKuWmrNuWJ+ZE3/G\nwsfoA2F4i3vymbKYz3aqUPQnxNjoZz6Cm9AbP9C3qHvIggY047GWtwIeY9uOz1gQ\nhUQSZQAc+KOUmJGZh9SJgMQxjNzIRQ7lSRa/87Dj/QL4k5N/9uaenc1WB3THr9lx\n0YE43PZsG0/WVQ3ze6ky40hQvHp5cNYjCabKpoLyg91tENSqbGMOB7xyih6GKere\nIQIDAQAB\n-----END PUBLIC KEY-----",
    "VAPID_PUBLIC_KEY": "BMKmnIYvuMU7CeHx-XL6Va7VB5DfB67mrMFPeWw4cOPU8sbWdFyHtscVcF1B2k4Hh6fFZbUNpX9KH_ehknKvn1E",
  },
  "env": {
    "preview": {
      "name": "andthen-preview",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "andthen-preview",
          "database_id": "c297d0f0-f7da-49eb-be95-e18d615690bb",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "STORY_ROOM", "class_name": "StoryRoom" }],
      },
      "ai": { "binding": "AI" },
      // `vars` aren't inherited from the top level.
      "vars": {
        "AI_PROVIDER": "workers-ai",
        "CLERK_JWT_KEY": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA0tCAv+NMQD8ZIEQx1DQe\nltHZ2cHdI/9OIobyaZ5nr/+HhNzZQV21azV5C7MXMdWY1SnlkcSjkwT1NfKAg/9F\njAiYOlEWWwZ41vzBiD+hZ2jGR5UhMaf/glec9lG1ZAStqO+FJKuWmrNuWJ+ZE3/G\nwsfoA2F4i3vymbKYz3aqUPQnxNjoZz6Cm9AbP9C3qHvIggY047GWtwIeY9uOz1gQ\nhUQSZQAc+KOUmJGZh9SJgMQxjNzIRQ7lSRa/87Dj/QL4k5N/9uaenc1WB3THr9lx\n0YE43PZsG0/WVQ3ze6ky40hQvHp5cNYjCabKpoLyg91tENSqbGMOB7xyih6GKere\nIQIDAQAB\n-----END PUBLIC KEY-----",
        "VAPID_PUBLIC_KEY": "BNbNBYmgShK2QjU5i70V-xwUsQuBs989ekvSVXp2J7Dt2iO2GXV7v7vNgpqIxCNi76FgAR08R-Vl9EHH-1jbYBI",
      },
    },
    "production": {
      "name": "andthen",
      "workers_dev": false,
      "routes": [{ "pattern": "app.andthen.page", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "andthen-prod",
          "database_id": "41d147d3-60ae-4b44-93c5-a0e047249ec6",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "STORY_ROOM", "class_name": "StoryRoom" }],
      },
      "ai": { "binding": "AI" },
      // `vars` aren't inherited from the top level.
      "vars": {
        "AI_PROVIDER": "workers-ai",
        "CLERK_JWT_KEY": "PLACEHOLDER-not-a-key-replace-with-the-clerk-instance-public-key-pem",
        "VAPID_PUBLIC_KEY": "BNqSWSuX5Uv2Zq162Ea7DLp0MANwRW-XMzmbqsZI3ngfEBmeVKgWXnbYxFokQBJzDHXDeTaY8zDCn7hgJTto3o0",
      },
    },
  },
}
