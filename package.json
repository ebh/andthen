{
  "name": "andthen",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "tamagui build --target web ./src/ui -- expo export --platform web --output-dir dist && node scripts/buildServiceWorker.ts",
    "cf-typegen": "wrangler types",
    "vapid-keys": "node scripts/generateVapidKeys.ts",
    "db:docs": "WRITE_DATABASE_DOC=1 vitest run src/worker/db/databaseDoc.integration.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && eslint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "stryker": "stryker run",
    "legal:check": "node scripts/checkLegalVersions.ts",
    "icons": "node scripts/renderIcons.ts",
    "postinstall": "node scripts/renderIcons.ts",
    "eas-build-post-install": "node scripts/ensureGeneratedCss.ts"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@clerk/backend": "3.27.0",
    "@clerk/expo": "4.15.1",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/source-serif-4": "0.4.2",
    "@expo/metro-runtime": "58.0.17",
    "@serwist/window": "9.5.13",
    "@tamagui/config": "3.1.10",
    "@tamagui/core": "3.1.10",
    "@tamagui/web": "3.1.10",
    "expo": "58.0.22",
    "expo-dev-client": "~58.0.18",
    "expo-font": "58.0.11",
    "expo-router": "58.0.29",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-system-ui": "58.0.7",
    "hono": "4.13.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "serwist": "9.5.13",
    "tamagui": "3.1.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@resvg/resvg-wasm": "2.6.2",
    "@serwist/build": "9.5.13",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tamagui/cli": "3.1.10",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eas-cli": "27.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-oxlint": "1.90.0",
    "jsdom": "30.1.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": "26.13.0"
  },
  "packageManager": "pnpm@12.16.1"
}
