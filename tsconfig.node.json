{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2024"],
    "types": ["node"],
    // Node runs scripts/*.ts as they are and needs the extension on an import. Nothing is emitted.
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.config.ts",
    "eslint.config.ts",
    "scripts",
    "src/worker/vapidKeys.ts",
    "src/shared/legalDocuments.ts",
    "src/shared/legalPageUrl.ts",
    "src/shared/legalPages.ts",
    "src/shared/legalVersionCheck.ts"
  ]
}
